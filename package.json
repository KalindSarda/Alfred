{
  "name": "finance-tracker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "migrate:local": "wrangler d1 migrations apply finance-tracker --local",
    "migrate:remote": "wrangler d1 migrations apply finance-tracker --remote"
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.1",
    "@tanstack/react-query": "5.105.0",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.14",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.7",
    "@cloudflare/workers-types": "5.20261026.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "wrangler": "4.152.0"
  }
}
